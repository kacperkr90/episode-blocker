{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://*.disneyplus.com/*",
    "https://*.youtube.com/*",
    "https://*.youtubekids.com/*",
    "https://*.cda.pl/*",
    "https://vod.tvp.pl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://*.disneyplus.com/*",
        "https://*.youtube.com/*",
        "https://*.youtubekids.com/*",
        "https://*.cda.pl/*",
        "https://vod.tvp.pl/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "locked.html",
        "locked.js",
        "lib.js"
      ],
      "matches": [
        "https://*.netflix.com/*",
        "https://*.disneyplus.com/*",
        "https://*.youtube.com/*",
        "https://*.youtubekids.com/*",
        "https://*.cda.pl/*",
        "https://vod.tvp.pl/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__"
  }
}